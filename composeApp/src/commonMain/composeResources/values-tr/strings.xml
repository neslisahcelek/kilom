    <!-- Micro-Period Titles, Bodies & Hormones -->
    <string name="cycle_menstrual_early_title">Menstrüel Arınma &amp; Dinlenme</string>
    <string name="cycle_menstrual_early_body">Prostaglandinler uterus kasılmasını tetikler. Enerji dinlenme seviyesindedir. Sıcak tutun, demir depolarını destekleyin ve bedeninize şefkat gösterin.</string>
    <string name="cycle_menstrual_early_hormones">Östrojen ve progesteron en düşük taban seviyesindedir. Prostaglandin aktivitesi yüksektir.</string>

    <string name="cycle_menstrual_late_title">Yenilenme &amp; Enerjinin Uyanışı</string>
    <string name="cycle_menstrual_late_body">Kanama hafifler, hücre yenilenmesi başlar. Vücut önceki döngüden kalan ödemi doğal olarak boşaltır.</string>
    <string name="cycle_menstrual_late_hormones">Östrojen yavaş ve kararlı yükselişine başlar. Progesteron henüz sakindir.</string>

    <string name="cycle_follicular_early_title">Yükselen Güç &amp; Zihinsel Netlik</string>
    <string name="cycle_follicular_early_body">İnsülin duyarlılığı zirvededir: kaslar karbonhidratları temiz yakıt olarak hızla çeker. Serotonin ve motivasyon yükselir.</string>
    <string name="cycle_follicular_early_hormones">Yükselen östrojen folikül gelişimini ve zihinsel canlılığı destekler.</string>

    <string name="cycle_follicular_late_title">Yumurtlama Öncesi Zirve</string>
    <string name="cycle_follicular_late_body">Dayanıklılık, metabolik esneklik ve fiziksel güç döngünün en yüksek seviyesindedir. Hafif testosteron özgüveni artırır.</string>
    <string name="cycle_follicular_late_hormones">Östrojen tepe noktasına ulaşır; ovülasyon öncesi hafif testosteron artışı eşlik eder.</string>

    <string name="cycle_ovulation_title">Ovülasyon (Yumurtlama) Zirvesi</string>
    <string name="cycle_ovulation_body">LH hormonu yumurta salınımını tetikler; vücut ısısı yaklaşık 0.3°C artar. Canlılık ve metabolizma en üst noktadadır.</string>
    <string name="cycle_ovulation_hormones">LH dalgası, tepe östrojen ve progesteron üretimine geçiş.</string>

    <string name="cycle_luteal_early_title">Metabolizma Hızlanması</string>
    <string name="cycle_luteal_early_body">Progesteron liderliği devralır ve bazal metabolizma hızını günde 100–200 kcal artırır. İştahın hafif açılması biyolojik bir gerekliliktir.</string>
    <string name="cycle_luteal_early_hormones">Progesteron baskındır, sakinleştirici GABA yollarını uyarır ve vücut ısısı yüksek kalır.</string>

    <string name="cycle_luteal_mid_title">Progesteron Zirvesi &amp; Ödem Başlangıcı</string>
    <string name="cycle_luteal_mid_body">Aldosteron hormonu böbreklerde tuz tutar: tartıdaki 0.8–1.5 kg artış tamamen sudur, ASLA yağ değildir! Magnezyum ödemi ve gerginliği yatıştırır.</string>
    <string name="cycle_luteal_mid_hormones">Progesteron zirvesi; aldosteron artışı; insülin duyarlılığında hafif düşüş.</string>

    <string name="cycle_luteal_late_title">PMS Eşiği &amp; Maksimum Ödem</string>
    <string name="cycle_luteal_late_body">Hormonların ani düşüşü 2.5 kg\'a varan su tutulması ve tatlı isteği yaratabilir. Tartının moralinizi bozmasına izin vermeyin. Dinlenin ve tuzdan kaçının.</string>
    <string name="cycle_luteal_late_hormones">Menstrüasyon öncesi östrojen ve progesteronun hızlı düşüşü.</string>

    <!-- Scientific Sources Text -->
    <string name="cycle_source_acog_title">ACOG (Amerikan Kadın Doğum ve Jinekoloji Koleji)</string>
    <string name="cycle_source_acog_desc">Menstrüel fizyoloji, prostaglandin kaynaklı uterus kasılmaları ve C vitamini kofaktörleriyle demir replasman protokolleri klinik kılavuzları.</string>
    <string name="cycle_source_sims_title">Dr. Stacy Sims, PhD (Stanford Egzersiz Fizyolojisi)</string>
    <string name="cycle_source_sims_desc">Kadın infradian ritmi, luteal faz metabolik harcama artışı (+100–300 kcal/gün) ve aldosteron kaynaklı sodyum/sıvı tutulması araştırmaları.</string>
    <string name="cycle_source_pubmed_title">Hakemli Endokrin ve Klinik Beslenme Çalışmaları</string>
    <string name="cycle_source_pubmed_desc">PMS sıvı regülasyonunda magnezyum ve B6 takviyesi (Obstetrics &amp; Gynecology) ve turpgillerdeki glukosinolatlar ile östrojen detoksu üzerine klinik yayınlar.</string>
